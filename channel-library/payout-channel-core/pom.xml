<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.scott.payment</groupId>
        <artifactId>channel-library</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>payout-channel-core</artifactId>
    <packaging>jar</packaging>
    <name>payout-channel-core</name>
    <description>代付渠道注册、路由和统一执行框架模块。</description>

    <!--本模块只实现代付渠道执行框架，不拥有代付交易状态、资金账户或结算业务规则。-->
    <dependencies>
        <!--面向稳定的代付渠道 SPI 和标准请求响应模型编程。-->
        <dependency>
            <groupId>com.scott.payment</groupId>
            <artifactId>payout-channel-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--提供渠道实现注册、依赖注入和生命周期管理。-->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
    </dependencies>
</project>
