<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.scott.payment</groupId>
        <artifactId>channel-library</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>payment-channel-mpgs</artifactId>
    <packaging>jar</packaging>
    <name>payment-channel-mpgs</name>
    <description>Mastercard Payment Gateway Services 支付渠道协议适配器。</description>

    <!--
        本模块只负责 MPGS 请求映射、响应解析、签名认证和渠道错误转换。
        不决定商户路由、交易状态机、重试补偿或资金处理规则。
    -->
    <dependencies>
        <!--实现标准支付渠道 SPI。-->
        <dependency>
            <groupId>com.scott.payment</groupId>
            <artifactId>payment-channel-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--复用渠道注册和统一执行框架。-->
        <dependency>
            <groupId>com.scott.payment</groupId>
            <artifactId>payment-channel-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--复用平台日志、异常、卡信息和通用值对象。-->
        <dependency>
            <groupId>com.scott.payment</groupId>
            <artifactId>component-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--Spring 依赖注入及轻量 Boot 自动配置支持，不构成独立应用。-->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
    </dependencies>
</project>
