<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.scott.payment</groupId>
        <artifactId>channel-library</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>payment-channel-api</artifactId>
    <packaging>jar</packaging>
    <name>payment-channel-api</name>
    <description>支付渠道请求、响应、能力枚举、异常和统一 SPI 契约模块。</description>

    <!--
        这是支付渠道依赖链最底层的纯 Java API，不能依赖 Spring、具体渠道实现或业务服务。
        新渠道只实现本模块契约，支付核心通过稳定接口调用，避免渠道 SDK 泄漏到业务层。
    -->
</project>
