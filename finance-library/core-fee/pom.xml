<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.scott.payment</groupId>
        <artifactId>finance-library</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>core-fee</artifactId>
    <packaging>jar</packaging>
    <name>core-fee</name>
    <description>标准费、阶梯费、退款返费及管理端费用换汇预览的纯计算内核。</description>

    <!--
        计算结果只由输入命令和规则决定，不访问 Spring、数据库、Redis、MQ 或远程服务。
        生产清分按商户配置生成标签币种百分比组件和 USD 固定费/上下限事实；真实结算汇率只能由后续结算模块统一锁定和应用。
    -->
    <dependencies>
        <!--计算过程中统一使用精确金额和币种值对象。-->
        <dependency>
            <groupId>com.scott.payment</groupId>
            <artifactId>model-money</artifactId>
            <version>${finance-library.version}</version>
        </dependency>
        <!--消费费用规则、命令和结果契约，不反向修改模型状态。-->
        <dependency>
            <groupId>com.scott.payment</groupId>
            <artifactId>model-fee</artifactId>
            <version>${finance-library.version}</version>
        </dependency>
    </dependencies>
</project>
