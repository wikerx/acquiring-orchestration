<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.scott.payment</groupId>
        <artifactId>acquiring-orchestration</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>service-data</artifactId>
    <name>service-data</name>
    <description>异步数据服务，负责消息消费、商户通知、安全审计和受控卡信息保管。</description>

    <!--
        本服务处理非核心交易的异步落库和回调投递，不拥有支付状态机，也不承担清分、结算计算。
        所有 MQ 消费必须幂等；商户通知只基于可信终态事件生成并支持失败补偿。
    -->
    <dependencies>
        <!--服务注册和配置中心。-->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <!--平台通用值对象、消息枚举、异常和响应模型。-->
        <dependency>
            <groupId>com.scott.payment</groupId>
            <artifactId>component-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--内部补偿 API、参数校验和统一异常处理。-->
        <dependency>
            <groupId>com.scott.payment</groupId>
            <artifactId>component-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--消费幂等、通知任务、审计日志和卡信息数据访问。-->
        <dependency>
            <groupId>com.scott.payment</groupId>
            <artifactId>component-db</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--消费去重、回调锁、重试状态和短期数据缓存。-->
        <dependency>
            <groupId>com.scott.payment</groupId>
            <artifactId>component-redis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--RocketMQ 消费、消息契约、重试和死信治理。-->
        <dependency>
            <groupId>com.scott.payment</groupId>
            <artifactId>component-mq</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--商户回调签名、加密和受控卡信息保护。-->
        <dependency>
            <groupId>com.scott.payment</groupId>
            <artifactId>component-security</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--以下依赖仅用于数据消费、持久化和分片 SQL 测试。-->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-parser-sql-engine-sql92</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--将服务及其运行时依赖重打包为可独立启动的 Spring Boot 制品。-->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
