<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.scott.payment</groupId>
        <artifactId>component-library</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>component-excel</artifactId>
    <packaging>jar</packaging>
    <name>component-excel</name>
    <description>后台和商户端共用的 Excel 导入导出模型、注解与处理组件。</description>

    <!--本模块只封装文件导入导出技术能力，不定义具体业务报表字段和业务查询规则。-->
    <dependencies>
        <!--复用全平台基础异常、工具和值对象。-->
        <dependency>
            <groupId>com.scott.payment</groupId>
            <artifactId>component-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!--用于流式输出下载文件及接收上传文件。-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!--Excel 文件解析和生成引擎。-->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>easyexcel</artifactId>
        </dependency>
    </dependencies>
</project>
