<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.scott.payment</groupId>
        <artifactId>component-library</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>component-nacos-encryption</artifactId>
    <packaging>jar</packaging>
    <name>component-nacos-encryption</name>
    <description>Nacos 2.x/3.x 客户端与服务端共用的 AES-GCM 配置加密 SPI。</description>

    <properties>
        <!--Nacos 2.3.2 容器仍使用 Java 8，插件字节码必须保持 Java 8 兼容。-->
        <java.version>8</java.version>
    </properties>

    <dependencies>
        <!--仅编译 SPI；Nacos 服务端或客户端运行时提供实际接口实现。-->
        <dependency>
            <groupId>com.alibaba.nacos</groupId>
            <artifactId>nacos-encryption-plugin</artifactId>
            <version>2.3.2</version>
            <scope>provided</scope>
        </dependency>
        <!--Nacos 2.3.2 启动全量 Dump 的 config_info Mapper 遗漏 encrypted_data_key，需在服务端 SPI 阶段兼容。-->
        <dependency>
            <groupId>com.alibaba.nacos</groupId>
            <artifactId>nacos-datasource-plugin</artifactId>
            <version>2.3.2</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!--Nacos datasource 发布 POM 未声明其公共工具依赖，仅供 Mapper 兼容测试运行。-->
        <dependency>
            <groupId>com.alibaba.nacos</groupId>
            <artifactId>nacos-common</artifactId>
            <version>2.3.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
